#!/usr/bin/env bash
# herdr action launcher: resolves a Neovim binary and the shared Lua CLI, then
# hands off. herdr invokes it as: bash bin/openloc-herdr <subcommand>.
set -euo pipefail

err() { printf 'openloc-herdr: %s\n' "$*" >&2; }

# nvim is frequently absent from the minimal PATH a server-spawned action gets.
resolve_nvim() {
  if [ -n "${OPENLOC_NVIM:-}" ] && [ -x "${OPENLOC_NVIM:-}" ]; then
    printf '%s\n' "$OPENLOC_NVIM"
    return 0
  fi
  if command -v nvim >/dev/null 2>&1; then
    command -v nvim
    return 0
  fi
  local cand
  for cand in /opt/homebrew/bin/nvim /usr/local/bin/nvim /usr/bin/nvim; do
    if [ -x "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

# HERDR_BIN_PATH may be unset in older herdr versions.
resolve_herdr() {
  if [ -n "${HERDR_BIN_PATH:-}" ] && [ -x "${HERDR_BIN_PATH:-}" ]; then
    printf '%s\n' "$HERDR_BIN_PATH"
    return 0
  fi
  command -v herdr
}

NVIM_BIN="$(resolve_nvim)" || { err 'no nvim found; set OPENLOC_NVIM'; exit 1; }

ROOT="${HERDR_PLUGIN_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
CLI="${OPENLOC_CLI:-$ROOT/cli/openloc.lua}"
[ -f "$CLI" ] || CLI="$ROOT/../lua/openloc/cli.lua"
[ -f "$CLI" ] || { err "no CLI found under $ROOT; reinstall the plugin"; exit 1; }

# Writes the pick helper: a stock-safe nvim -l script that decodes the herdr
# context JSON and runs the shared detector. JSON parsing stays in Lua.
write_helper() {
  cat >"$1" <<'OPENLOC_HELPER_EOF'
-- Generated at runtime by openloc-herdr pick; never installed.
-- nvim -l publishes its own server socket; retract it before anything else.
pcall(vim.fn.serverstop, vim.v.servername)

local mode = (_G.arg and _G.arg[1]) or 'detect'

local ctx = {}
local raw = vim.env.HERDR_PLUGIN_CONTEXT_JSON
if raw and raw ~= '' then
  local ok, decoded = pcall(vim.json.decode, raw)
  if ok and type(decoded) == 'table' then ctx = decoded end
end

local function str(v)
  if type(v) == 'string' and v ~= '' then return v end
  return nil
end

if mode == 'pane-id' then
  io.write(str(ctx.focused_pane_id) or '')
  os.exit(0)
end

local lua_dir = str(vim.env.OPENLOC_LUA_DIR)
if not lua_dir then os.exit(1) end
package.path = lua_dir .. '/?.lua;' .. lua_dir .. '/?/init.lua;' .. package.path
local ok, detect = pcall(require, 'openloc.detect')
if not ok then
  io.stderr:write('openloc: cannot load openloc.detect from ' .. lua_dir .. '\n')
  os.exit(1)
end

local bases = {}
local function base(v)
  if str(v) then bases[#bases + 1] = v end
end
if type(ctx.worktree) == 'table' then base(ctx.worktree.checkout_path) end
base(ctx.workspace_cwd)
base(ctx.focused_pane_cwd)
base(vim.env.PWD)

-- Rows are "path<TAB>line<TAB>col", newest (last in text) first, deduped.
local function emit(matches)
  local seen, out = {}, {}
  for i = #matches, 1, -1 do
    local m = matches[i]
    local row = m.path
      .. '\t' .. (m.line and tostring(m.line) or '')
      .. '\t' .. (m.col and tostring(m.col) or '')
    if not seen[row] then
      seen[row] = true
      out[#out + 1] = row
    end
  end
  if #out > 0 then
    io.write(table.concat(out, '\n') .. '\n')
  end
  os.exit(0)
end

-- A selection that already parses wins over the pane scan.
local sel = str(ctx.selected_text)
if sel then
  local m = detect.detect(sel, bases)
  if #m > 0 then emit(m) end
end

emit(detect.detect(vim.env.OPENLOC_PICK_TEXT or '', bases))
OPENLOC_HELPER_EOF
}

do_pick() {
  local herdr_bin=""
  herdr_bin="$(resolve_herdr 2>/dev/null || true)"

  local lua_dir="" d
  for d in "$ROOT/../lua" "$ROOT/lua"; do
    if [ -d "$d/openloc" ]; then
      lua_dir="$(cd -- "$d" && pwd)"
      break
    fi
  done
  if [ -z "$lua_dir" ]; then
    err 'openloc lua tree not found; reinstall the plugin'
    exit 1
  fi

  local helper
  helper="$(mktemp "${TMPDIR:-/tmp}/openloc-pick.XXXXXX")"
  trap 'rm -f "$helper"' EXIT
  write_helper "$helper"

  local pane
  pane="$(OPENLOC_LUA_DIR="$lua_dir" "$NVIM_BIN" -l "$helper" pane-id || true)"
  if [ -z "$pane" ]; then
    pane="${HERDR_PANE_ID:-}"
  fi

  # OPENLOC_PICK_TEXT preset in the environment skips the pane read (test seam).
  if [ -z "${OPENLOC_PICK_TEXT+x}" ] && [ -n "$herdr_bin" ] && [ -n "$pane" ]; then
    OPENLOC_PICK_TEXT="$("$herdr_bin" pane read "$pane" --source recent-unwrapped --lines 300 --format text || true)"
  fi
  export OPENLOC_PICK_TEXT="${OPENLOC_PICK_TEXT:-}"

  local candidates
  candidates="$(OPENLOC_LUA_DIR="$lua_dir" "$NVIM_BIN" -l "$helper" detect || true)"
  if [ -z "$candidates" ]; then
    err 'no file references found'
    exit 0
  fi

  local count
  count="$(printf '%s\n' "$candidates" | wc -l | tr -d ' ')"

  # Menu only with a real tty; herdr runs actions detached, so the default is
  # the newest reference (row 1).
  local choice=1
  if [ "$count" -gt 1 ] && { : </dev/tty; } 2>/dev/null; then
    local i=1 p l
    while IFS=$'\t' read -r p l _; do
      printf '%2d) %s%s\n' "$i" "$p" "${l:+:$l}" >&2
      i=$((i + 1))
    done <<EOF
$candidates
EOF
    printf 'openloc pick [1-%d, newest first]: ' "$count" >&2
    local answer=""
    IFS= read -r -t 60 answer 2>/dev/null </dev/tty || answer=""
    case "$answer" in
      '' | *[!0-9]*) ;;
      *)
        if [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ]; then
          choice="$answer"
        fi
        ;;
    esac
  fi

  local row path lno cno
  row="$(printf '%s\n' "$candidates" | sed -n "${choice}p")"
  IFS=$'\t' read -r path lno cno <<EOF
$row
EOF
  if [ -z "$path" ]; then
    err 'internal: empty candidate row'
    exit 1
  fi

  set -- open "$path"
  if [ -n "$lno" ]; then
    set -- "$@" --line "$lno"
  fi
  if [ -n "$cno" ]; then
    set -- "$@" --col "$cno"
  fi
  # bash skips EXIT traps across exec; the helper is already consumed.
  rm -f "$helper"
  trap - EXIT
  exec "$NVIM_BIN" -l "$CLI" "$@"
}

cmd="${1:-}"
case "$cmd" in
  open-url)
    url="${2:-${HERDR_PLUGIN_CLICKED_URL:-}}"
    if [ -z "$url" ]; then
      # usage error, matching the CLI's exit for the same missing argument
      err 'no clicked URL in argv or environment'
      exit 1
    fi
    exec "$NVIM_BIN" -l "$CLI" open-url "$url"
    ;;
  pick)
    do_pick
    ;;
  '')
    err 'usage: openloc-herdr <pick|open-url|open|list|doctor> [args]'
    exit 1
    ;;
  *)
    exec "$NVIM_BIN" -l "$CLI" "$@"
    ;;
esac
