#!/usr/bin/env bash
# herdr action launcher: resolves a Neovim binary and the shared Lua CLI, then
# hands off. herdr invokes it as: bash bin/openloc-herdr <subcommand>.
set -euo pipefail

err() { printf 'openloc-herdr: %s\n' "$*" >&2; }

# nvim is frequently absent from the minimal PATH a server-spawned action gets.
resolve_nvim() {
  if [ -n "${OPENLOC_NVIM:-}" ] && [ -x "${OPENLOC_NVIM:-}" ]; then
    printf '%s\n' "$OPENLOC_NVIM"
    return 0
  fi
  if command -v nvim >/dev/null 2>&1; then
    command -v nvim
    return 0
  fi
  local cand
  for cand in /opt/homebrew/bin/nvim /usr/local/bin/nvim /usr/bin/nvim; do
    if [ -x "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

# HERDR_BIN_PATH may be unset in older herdr versions.
resolve_herdr() {
  if [ -n "${HERDR_BIN_PATH:-}" ] && [ -x "${HERDR_BIN_PATH:-}" ]; then
    printf '%s\n' "$HERDR_BIN_PATH"
    return 0
  fi
  command -v herdr
}

# Actions run detached, so a failed open is invisible without a toast.
toast_failure() {
  local status="$1" first="$2" herdr_bin
  herdr_bin="$(resolve_herdr 2>/dev/null || true)"
  if [ -n "$herdr_bin" ]; then
    "$herdr_bin" notification show 'openloc: open failed' \
      --body "${first:-exit $status}" --sound none >/dev/null 2>&1 || true
  fi
}

# Runs the CLI once and toasts the first stderr line on failure. Exit 6
# (ambiguous) is a routing outcome, not a failure: no toast.
run_cli_notify() {
  local stderr_file status first
  stderr_file="$(mktemp "${TMPDIR:-/tmp}/openloc-err.XXXXXX")"
  status=0
  "$NVIM_BIN" -l "$CLI" "$@" 2>"$stderr_file" || status=$?
  cat "$stderr_file" >&2
  if [ "$status" -ne 0 ] && [ "$status" -ne 6 ]; then
    first="$(head -n 1 "$stderr_file" 2>/dev/null || true)"
    toast_failure "$status" "$first"
  fi
  rm -f "$stderr_file"
  exit "$status"
}

tab_join() {
  local IFS=$'\t'
  printf '%s' "$*"
}

# Runs the CLI with the ambiguity election on. Exit 6 raises the chooser
# popup, passing the raw JSON through untouched; no herdr or a failed popup
# falls back to the top candidate so a click never dead-ends. Never returns.
#
# A failing exit toasts from THIS run's stderr and never re-runs the CLI: a
# second election can elect a different editor, and after exit 4 or 5 the
# first one may already hold the file. Only exit 6 is safe to re-run, because
# it is defined as having opened nothing.
run_cli_choose() {
  local out stderr_file status first herdr_bin
  stderr_file="$(mktemp "${TMPDIR:-/tmp}/openloc-err.XXXXXX")"
  status=0
  out="$("$NVIM_BIN" -l "$CLI" "$@" --choose auto --json 2>"$stderr_file")" || status=$?
  cat "$stderr_file" >&2

  if [ "$status" -eq 0 ]; then
    rm -f "$stderr_file"
    [ -n "$out" ] && printf '%s\n' "$out"
    exit 0
  fi

  if [ "$status" -eq 6 ]; then
    rm -f "$stderr_file"
    herdr_bin="$(resolve_herdr 2>/dev/null || true)"
    if [ -n "$herdr_bin" ] && "$herdr_bin" plugin pane open --plugin openloc --entrypoint choose \
      --placement popup --width '70%' --height '50%' --focus \
      --env OPENLOC_CHOOSE_JSON="$out" --env OPENLOC_CHOOSE_ARGS="$(tab_join "$@")" \
      >/dev/null 2>&1; then
      exit 0
    fi
    run_cli_notify "$@" --choose never
  fi

  first="$(head -n 1 "$stderr_file" 2>/dev/null || true)"
  rm -f "$stderr_file"
  toast_failure "$status" "$first"
  exit "$status"
}

NVIM_BIN="$(resolve_nvim)" || { err 'no nvim found; set OPENLOC_NVIM'; exit 1; }

ROOT="${HERDR_PLUGIN_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
CLI="${OPENLOC_CLI:-$ROOT/cli/openloc.lua}"
[ -f "$CLI" ] || CLI="$ROOT/../lua/openloc/cli.lua"
[ -f "$CLI" ] || { err "no CLI found under $ROOT; reinstall the plugin"; exit 1; }

cmd="${1:-}"
case "$cmd" in
  open-url)
    url="${2:-${HERDR_PLUGIN_CLICKED_URL:-}}"
    if [ -z "$url" ]; then
      # usage error, matching the CLI's exit for the same missing argument
      err 'no clicked URL in argv or environment'
      exit 1
    fi
    run_cli_choose open-url "$url"
    ;;
  '')
    err 'usage: openloc-herdr <open-url|open|list|doctor> [args]'
    exit 1
    ;;
  *)
    exec "$NVIM_BIN" -l "$CLI" "$@"
    ;;
esac
